#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUN_BIN=${ATOM_BUN_BIN:-bun}

if ! command -v "$BUN_BIN" >/dev/null 2>&1; then
  echo "SPlayer Atom Core: Bun runtime not found: $BUN_BIN" >&2
  exit 127
fi
export NODE_ENV=production
export ATOM_RESOURCES_DIR="${ATOM_RESOURCES_DIR:-$ROOT_DIR}"
exec "$BUN_BIN" "$ROOT_DIR/app/index.js" "$@"
