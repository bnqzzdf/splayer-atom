#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${ATOM_NODE_BIN:-}" ]; then
  NODE_BIN=$ATOM_NODE_BIN
elif [ -x "$ROOT_DIR/runtime/bin/node" ]; then
  NODE_BIN=$ROOT_DIR/runtime/bin/node
else
  NODE_BIN=node
fi

if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  echo "SPlayer Atom Core: Node runtime not found: $NODE_BIN" >&2
  exit 127
fi

export NODE_ENV=production
exec "$NODE_BIN" "$ROOT_DIR/app/index.js" "$@"
