[Unit]
Description=SPlayer Atom Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# @ATOM_SERVICE_USER@
WorkingDirectory=/opt/splayer-atom-core
ExecStart=/opt/splayer-atom-core/bin/splayer-atom-core
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# 可选：覆盖监听端口，默认 14558。
# Environment=ATOM_SERVER_PORT=14558
# Diretta Host 需要 root 时使用 root service；普通 ALSA Core 建议改为专用非特权用户。

[Install]
WantedBy=multi-user.target
