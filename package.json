{
  "name": "splayer-atom",
  "productName": "SPlayer Atom",
  "version": "1.0.0-rc.2",
  "description": "Linux x86-64 Web + Core music player adapted from SPlayer-Next",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "author": {
    "name": "SPlayer Atom contributors",
    "url": "https://github.com/bnqzzdf/splayer-atom"
  },
  "homepage": "https://github.com/bnqzzdf/splayer-atom",
  "repository": {
    "type": "git",
    "url": "https://github.com/bnqzzdf/splayer-atom"
  },
  "bugs": {
    "url": "https://github.com/bnqzzdf/splayer-atom/issues"
  },
  "license": "AGPL-3.0",
  "license-file": "LICENSE",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "pnpm test:node && pnpm test:web",
    "test:node": "tsx --tsconfig tsconfig.node.json --test \"core/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:web": "vitest run --config vitest.config.ts",
    "test:web:watch": "vitest --config vitest.config.ts",
    "test:native": "cargo test --workspace",
    "test:all": "pnpm test && pnpm test:native",
    "build:native": "tsx scripts/atom/build-core-native.ts",
    "build:core": "vite build -c scripts/atom/vite.core.config.ts",
    "build:web": "vite build -c vite.config.ts",
    "build": "rimraf out/core out/renderer out/native && pnpm build:native && pnpm typecheck && pnpm build:core && pnpm build:web",
    "package:core:debian11": "bash scripts/atom/build-debian11-bundled.sh",
    "start": "node out/core/index.js",
    "dev": "pnpm build:native --dev && tsx scripts/dev.ts",
    "package:core": "tsx scripts/atom/build-core-system.ts",
    "package:core:bundled": "tsx scripts/atom/build-core-system.ts --bundle-node",
    "check:hardware-release": "tsx scripts/atom/check-hardware-release.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "atomically": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.13.0",
    "undici": "^8.10.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@iconify-json/lucide": "^1.2.101",
    "@iconify-json/material-symbols": "^1.2.88",
    "@material/material-color-utilities": "^0.4.0",
    "@napi-rs/cli": "^3.8.2",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.17",
    "@types/sortablejs": "^1.15.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "colord": "^2.9.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "localforage": "^1.10.0",
    "marked": "^18.0.9",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.1",
    "rimraf": "^6.1.3",
    "sortablejs": "^1.15.7",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.58.1",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.1.0",
    "uqr": "^0.1.3",
    "vite": "^7.3.6",
    "vitepress": "2.0.0-alpha.15",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  }
}
